# Canonical public URL used for metadata, schema, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://luckyscanoeandcabin.com

# Optional Google Search Console HTML-tag verification value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact form. Keep the real API key only in .env.local and Vercel.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Lucky's Website <forms@hometownwebservicesar.cc>"
CONTACT_TO_EMAIL=info@caddocanoeandkayak.com

# Optional. The USGS API works without a key at lower request limits.
USGS_API_KEY=
